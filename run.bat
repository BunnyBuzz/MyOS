@echo off
echo [*] Assembling bootloader...
nasm -f bin boot.asm -o boot.bin

echo [*] Assembling kernel bridge...
nasm -f elf32 bridge.asm -o kernel_entry.o

echo [*] Compiling kernel.cpp...
gcc -m32 -ffreestanding -c kernel.cpp -o kernel.o

echo [*] Linking kernel...
ld -m i386pe -o kernel.tmp -Ttext 0x1000 kernel_entry.o kernel.o

echo [*] Converting to flat binary (stripping PE relocations)...
objcopy -O binary -R .reloc -R .idata kernel.tmp kernel.bin

echo [*] Creating OS disk image...
copy /b boot.bin + kernel.bin os-image.bin > nul
copy /y os-image.bin os.bin > nul

echo [*] Launching QEMU...
qemu-system-x86_64 -drive format=raw,file=os-image.bin
